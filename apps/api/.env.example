# Database (PostgreSQL / Neon / Supabase)
# For local PostgreSQL, set both DATABASE_URL and DIRECT_URL to the same connection string.
# For Neon / Supabase, DATABASE_URL is the pooled connection and DIRECT_URL is the direct connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hms_db?schema=public"

# Backend Server Configuration
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Auth & Secrets
JWT_SECRET="demo-super-secret-key-change-in-production-min-64-characters-long"
JWT_REFRESH_SECRET="demo-refresh-secret-key-change-in-production-min-64-characters"
AI_SERVICE_JWT_SECRET="demo-ai-service-secret-strictly-scoped-for-voice-agent"
ARGON2_PEPPER="optional-pepper-secret"

# Email Delivery (Resend API)
RESEND_API_KEY="re_demo_123456789"